# =============================================================================
# shiftapp environment variables
# =============================================================================
# Copy to `.env` for local use, or set these in the Railway service "Variables"
# tab for deployment. Every variable here has a sensible LOCAL default baked
# into application.properties, so you only need to override what differs.
#
# NEVER commit a real `.env` with secrets — it is gitignored.
# =============================================================================

# --- Database (Neon) ---------------------------------------------------------
# Convert your Neon connection string into a JDBC URL:
#   Neon gives:  postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
#   Use as JDBC: jdbc:postgresql://HOST/DB?sslmode=require
# Put USER/PASSWORD in the dedicated variables below (pgJDBC handles them better
# as separate fields than embedded in the URL).
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-red-meadow-aofsq3oy-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your-neon-password

# Use `update` on a hosted DB so deploys don't wipe data each restart.
# (Local default is `create-drop`.)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# --- Server ------------------------------------------------------------------
# Railway injects $PORT automatically; you normally do NOT set this yourself.
# PORT=8080

# --- Security ----------------------------------------------------------------
# Generate a strong value, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Behind Railway's HTTPS, mark the refresh cookie secure.
APP_AUTH_REFRESH_COOKIE_SECURE=true
